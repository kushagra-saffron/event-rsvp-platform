# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: cron reminders (48h) use RPCs with elevated access
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: site URL for OAuth redirects (Vercel production URL or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — RSVP confirmation + reminder emails
RESEND_API_KEY=
# Example: MoneyStage <notifications@yourdomain.com> or Resend onboarding sender
RESEND_FROM_EMAIL=

# Protect /api/cron/remind-48h in production (Authorization: Bearer <secret>)
CRON_SECRET=
